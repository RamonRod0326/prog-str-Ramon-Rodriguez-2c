<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.demolistview.controllers.AppControllers">
   <children>
      <Label text="Lista de personas" translateX="10.0" />
      <GridPane prefHeight="111.0" prefWidth="600.0">
        <columnConstraints>
          <ColumnConstraints hgrow="SOMETIMES" maxWidth="295.0" minWidth="10.0" prefWidth="135.0" />
          <ColumnConstraints hgrow="SOMETIMES" maxWidth="467.0" minWidth="10.0" prefWidth="465.0" />
        </columnConstraints>
        <rowConstraints>
          <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
          <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
            <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
        </rowConstraints>
         <children>
            <TextField fx:id="txtName" prefHeight="25.0" prefWidth="339.0" style="-fx-background-color: white; -fx-border-width: 1; -fx-border-color: grey; -fx-border-radius: 10;" GridPane.columnIndex="1" />
            <TextField fx:id="txtEmail" style="-fx-background-color: white; -fx-border-width: 1; -fx-border-color: grey; -fx-border-radius: 10;" GridPane.columnIndex="1" GridPane.rowIndex="1" />
            <Label text="Nombre" translateX="20.0" />
            <Label text="Email" translateX="20.0" GridPane.rowIndex="1" />
            <Label layoutX="10.0" layoutY="16.0" text="Edad" translateX="20.0" GridPane.rowIndex="2" />
            <TextField fx:id="txtAge" layoutX="310.0" layoutY="40.0" style="-fx-background-color: white; -fx-border-width: 1; -fx-border-color: grey; -fx-border-radius: 10;" GridPane.columnIndex="1" GridPane.rowIndex="2" />
         </children>
      </GridPane>
      <ListView fx:id="listView" prefHeight="200.0" prefWidth="200.0" />
      <HBox prefHeight="88.0" prefWidth="600.0">
         <children>
            <Button mnemonicParsing="false" onAction="#onReload" style="-fx-background-color: blue; -fx-border-radius: 10;" text="Recargar" textFill="WHITE" translateX="20.0">
               <font>
                  <Font name="System Bold" size="12.0" />
               </font></Button>
            <Button mnemonicParsing="false" onAction="#onAdd" style="-fx-background-color: blue; -fx-border-radius: 10;" text="Agregar" textFill="WHITE" translateX="30.0">
               <font>
                  <Font name="System Bold" size="12.0" />
               </font></Button>
             <Button mnemonicParsing="false" onAction="#onUpdate" style="-fx-background-color: blue; -fx-border-radius: 10;" text="Actualizar" textFill="WHITE" translateX="30.0">
                 <font>
                     <Font name="System Bold" size="12.0" />
                 </font></Button>
             <Button mnemonicParsing="false" onAction="#onRemove" style="-fx-background-color: blue; -fx-border-radius: 10;" text="Eliminar" textFill="WHITE" translateX="30.0">
                 <font>
                     <Font name="System Bold" size="12.0" />
                 </font></Button>
         </children>
      </HBox>
      <Label fx:id="lblMsg" />
   </children>
</VBox>